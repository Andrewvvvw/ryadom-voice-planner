HOST=127.0.0.1
PORT=3000
# Published Docker port on the host; the container still listens on 3000.
RYADOM_HTTP_PORT=3001
DATABASE_PATH=.local/ryadom.sqlite
# Optional: OpenAI-compatible chat completions, including local Ollama.
# Without LLM_MODEL the application uses its deterministic local parser.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# Example Ollama: LLM_BASE_URL=http://localhost:11434/v1, LLM_MODEL=qwen3:8b
# Explicitly enable sending search text and up to 60 candidate titles to the LLM:
LLM_SEARCH=false
